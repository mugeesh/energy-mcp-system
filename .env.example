# Copy to .env and fill in your own values.

# --- DeepSeek (MCP client LLM) ---------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2

# --- MCP transport ----------------------------------------------------------
# stdio for local `uv run`, streamable-http for docker compose / remote.
MCP_TRANSPORT=streamable-http
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8001
MCP_HTTP_PATH=/mcp

# --- IAM API ---------------------------------------------------------------
# Auth is per request: the frontend sends Authorization: Bearer <token>.
# No username/password is used by the server.
IAM_URL=https://iam.staging.energybox.com
# IAM routes are versioned (/api/v1/sites, /api/v1/users). Override if needed.
IAM_API_PREFIX=/api/v1
ENERGYBOX_API_BASE_URL=https://iam.staging.energybox.com

# --- Time-series / energy API ----------------------------------------------
ts_api_url=https://ts.staging.energybox.com

# --- App tuning ------------------------------------------------------------
LOG_LEVEL=INFO
MCP_MAX_HISTORY=12
MCP_MAX_STEPS=8
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
